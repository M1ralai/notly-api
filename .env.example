API_PORT=8080
PUBLIC_APP_URL=https://app.notly.tr

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=notly
DB_SSLMODE=disable

# Authentication
JWT_SECRET=change-me-use-a-long-random-value

# AES-256 key for encrypted third-party tokens. Must be exactly 32 bytes.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Email verification (optional)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com

# Bot protection (optional). When set, login/register require turnstile_token.
TURNSTILE_SECRET_KEY=

# Google Calendar integration (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/calendar/google/callback

# S3-compatible attachment storage (optional)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=notly-media
MINIO_USE_SSL=false
